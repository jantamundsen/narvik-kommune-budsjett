g for andre selskaper, kommuner mv.   Selskapet skal være på vakt for fellesskapets verdier, og skal gjennom dialog og samhandling med folkevalgte og administrativt nivå i eierkommunene, og gjennom sin revisjon- og kontrollaktivitet, bidra til å styrke tilliten til kommunal forvaltning.   Selskapet skal levere sine tjenester til selvkost, og har ikke erverv til formål.   Avtale om revisjon inngås mellom oppdragsgiverne og selskapet ved daglig leder.","ansatte":63,"stiftet":"2003-12-11","naering":"Generell offentlig administrasjon","kommune":"Harstad","hjemmeside":"www.komrevnord.no","sektor":"Kommuneforvaltningen","under_avvikling":false,"konkurs":false,"slettet":null},"regnskap":{}},{"id":"k-sekretariatet","navn":"K-Sekretariatet IKS","orgnr":"988064920","form":"IKS","eierandel":6.24,"bokfort":83000,"note":"andeler","gjeldsansvar":true,"brreg":{"navn":"K-SEKRETARIATET IKS","form":"Interkommunalt selskap","formaal":"Utføre sekretariatsfunksjonen for deltakernes kontrollutvalg og hva dermed står i naturlig forbindelse.","ansatte":6,"stiftet":"2004-11-05","naering":"Generell offentlig administrasjon","kommune":"Tromsø","hjemmeside":"www.k-sek.no","sektor":"Kommuneforvaltningen","under_avvikling":false,"konkurs":false,"slettet":null},"regnskap_merknad":null,"regnskap":{"selskap":{"2023":{"driftsinntekter":11381327,"driftskostnader":10551013,"lonn":8834633,"driftsresultat":830314,"finans":418397,"aarsresultat":1248711,"eiendeler":8696813,"anleggsmidler":175587,"egenkapital":7245149,"gjeld":1451664,"langsiktig_gjeld":0,"kilde":"ksek-2025","sider":[22,23],"fra_pdf":true},"2024":{"driftsinntekter":11979300,"driftskostnader":11436761,"lonn":8983344,"driftsresultat":542539,"finans":482815,"aarsresultat":1025354,"eiendeler":10052430,"anleggsmidler":201790,"egenkapital":6270503,"gjeld":3781927,"langsiktig_gjeld":0,"kilde":"ksek-2025","sider":[22,23],"fra_pdf":true},"2025":{"driftsinntekter":12498000,"driftskostnader":11842369,"lonn":9661321,"driftsresultat":655631,"finans":485